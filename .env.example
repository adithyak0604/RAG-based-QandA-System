# Copy this file to .env and fill in real values. .env is git-ignored —
# only THIS template (.env.example) should ever be committed.

ENV = development

# --- OpenRouter ---
OPENROUTER_API_KEY = 
OPENROUTER_MODEL = nvidia/nemotron-3-ultra-550b-a55b:free  #Any other LLM of your choice.

# --- Ollama (local) ---
OLLAMA_BASE_URL = http://localhost:11434/v1
OLLAMA_MODEL = llama3.2:3b      #or Any other model you pulled from Ollama

# --- LLM backend override: auto | ollama | openrouter ---
LLM_BACKEND=auto

# --- Storage paths (defaults are usually fine for local dev) ---
VECTOR_STORE_PATH=./data/vector_store
QUESTION_STORE_PATH=./data/question_sets.db
